<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/TemaApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SemanaActivity"
            android:exported="false"
            android:label="@string/titulo_semana"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ExportarActivity"
            android:exported="false"
            android:label="@string/titulo_exportar"
            android:parentActivityName=".MainActivity" />

        <!-- Proveedor propio para compartir los archivos generados (texto, PNG, PDF)
             sin depender de AndroidX FileProvider. -->
        <provider
            android:name=".ArchivosProvider"
            android:authorities="mx.tianguis.cuentas.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
