<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/op_texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/boton_plano"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✎"
            android:textColor="@color/primario"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compartir_texto"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/compartir_texto_desc"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/op_imagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/boton_plano"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▣"
            android:textColor="@color/artesano_a"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compartir_imagen"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/compartir_imagen_desc"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/op_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/boton_plano"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▤"
            android:textColor="@color/peligro"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compartir_pdf"
                android:textColor="@color/texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/compartir_pdf_desc"
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
