<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- ===== Barra de fecha ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primario"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/btn_dia_anterior"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/dia_anterior"
            android:gravity="center"
            android:text="◀"
            android:textColor="@color/blanco"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/btn_fecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/txt_dia_semana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="VIERNES"
                android:textColor="#9FD6CE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 de agosto"
                android:textColor="@color/blanco"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_dia_siguiente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/dia_siguiente"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/blanco"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btn_hoy"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/boton_plano"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/hoy"
            android:textColor="@color/primario"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Tarjeta para anotar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/tarjeta"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_a"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/chip_a"
                android:gravity="center"
                android:text="A · Angel"
                android:textColor="@color/artesano_a"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_b"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@drawable/chip_b"
                android:gravity="center"
                android:text="B · Bryan"
                android:textColor="@color/artesano_b"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/campo_descripcion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/campo"
            android:hint="@string/descripcion_hint"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/campo_cantidad"
                android:layout_width="86dp"
                android:layout_height="50dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/campo"
                android:gravity="center"
                android:hint="@string/cantidad_hint"
                android:inputType="number"
                android:maxLines="1"
                android:text="1"
                android:textColor="@color/texto"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/campo_precio"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/campo"
                android:hint="@string/precio_hint"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/texto"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_agregar"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/agregar" />
    </LinearLayout>

    <!-- ===== Lista de ventas del día ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp"
            android:paddingTop="6dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/txt_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/sin_ventas"
            android:textColor="@color/texto_suave"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- ===== Totales del día ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/linea" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lbl_total_a"
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANGEL (A)"
                    android:textColor="@color/artesano_a" />

                <TextView
                    android:id="@+id/txt_total_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lbl_total_b"
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRYAN (B)"
                    android:textColor="@color/artesano_b" />

                <TextView
                    android:id="@+id/txt_total_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:orientation="vertical">

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_dia" />

                <TextView
                    android:id="@+id/txt_total_dia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/primario"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <Button
                android:id="@+id/btn_semana"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/boton_plano"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/titulo_semana"
                android:textColor="@color/primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_exportar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/boton_plano"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/menu_exportar"
                android:textColor="@color/primario"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_compartir"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/menu_compartir"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
