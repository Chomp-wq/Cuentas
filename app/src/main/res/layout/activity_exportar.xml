<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ======================= ¿Qué días? ======================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/que_dias"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/op_hoy"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/rango_hoy" />

                    <TextView
                        android:id="@+id/op_ayer"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/rango_ayer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/op_esta_semana"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/rango_esta_semana" />

                    <TextView
                        android:id="@+id/op_semana_pasada"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/rango_semana_pasada" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/op_este_mes"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/rango_este_mes" />

                    <TextView
                        android:id="@+id/op_mes_pasado"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/rango_mes_pasado" />
                </LinearLayout>

                <TextView
                    android:id="@+id/op_rango"
                    style="@style/Opcion"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="@string/rango_entre_fechas" />

                <TextView
                    android:id="@+id/op_dias_sueltos"
                    style="@style/Opcion"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="@string/rango_dias_sueltos" />

                <TextView
                    android:id="@+id/op_semanas"
                    style="@style/Opcion"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="@string/rango_semanas" />

                <TextView
                    android:id="@+id/op_todo"
                    style="@style/Opcion"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="@string/rango_todo" />
            </LinearLayout>

            <!-- ======================= ¿De quién? ======================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/de_quien"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/quien_ambos"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/los_dos" />

                    <TextView
                        android:id="@+id/quien_a"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="A" />

                    <TextView
                        android:id="@+id/quien_b"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="B" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== ¿Cómo se ordena? ==================== -->
            <LinearLayout
                android:id="@+id/tarjeta_orden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/como_se_ordena"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orden_dia"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/orden_dia" />

                    <TextView
                        android:id="@+id/orden_semana"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/orden_semana" />

                    <TextView
                        android:id="@+id/orden_resumen"
                        style="@style/Opcion"
                        android:layout_width="0dp"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/orden_resumen" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ========================== Lo que saldrá ======================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/linea" />

        <TextView
            android:id="@+id/txt_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="10dp"
            android:text="Esta semana"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="0 días · 0 piezas"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                style="@style/Etiqueta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_reporte"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="@color/primario"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_compartir_reporte"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/compartir_reporte" />
    </LinearLayout>

</LinearLayout>
