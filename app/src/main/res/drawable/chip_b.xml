<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/artesano_b" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/artesano_b" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/artesano_b_suave" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#F0C0D6" />
        </shape>
    </item>
</selector>
