<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TemaApp" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primario</item>
        <item name="android:colorPrimaryDark">@color/primario_oscuro</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto</item>
    </style>

    <!-- Texto de las etiquetas pequeñas en mayúsculas. -->
    <style name="Etiqueta">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Botón de opción de la pantalla de exportar: se prende al elegirlo. -->
    <style name="Opcion">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/opcion</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonPrincipal">
        <item name="android:background">@drawable/boton_principal</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

</resources>
